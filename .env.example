# Copy to .env and fill in real values (.env is git-ignored).

# Gemini AI receipt analysis (key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Leave DATABASE_URL unset locally to use SQLite (instance/airost.db).

# Generate your own, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
