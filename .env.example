# Copy to .env and fill in real values (.env is git-ignored).

# Gemini AI receipt analysis (key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional model for the AI review assistant (defaults to GEMINI_MODEL)
GEMINI_REVIEW_MODEL=

# Email notifications through Brevo (optional; MAIL_FROM must be a verified Brevo sender)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=AIROST Finance Hub

# Leave DATABASE_URL unset locally to use SQLite (instance/airost.db).

# Generate your own, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
